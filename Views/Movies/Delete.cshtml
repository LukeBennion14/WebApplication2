@model WebApplication2.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h2>Delete Movie</h2>

<h4>Are you sure you want to delete this movie?</h4>

<div>
    <p><strong>Title:</strong> @Model.Title</p>
    <p><strong>Director:</strong> @Model.Director</p>
    <p><strong>Year:</strong> @Model.Year</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>